<resources xmlns:tools="http://schemas.android.com/tools">
    <dimen name="commandroid_terminal_text_size">14sp</dimen>
    <dimen name="commandroid_terminal_padding">4dp</dimen>
    <!-- Spec mandates a 2px composing underline. -->
    <dimen name="commandroid_composing_underline" tools:ignore="PxUsage">2px</dimen>
    <!-- Spec: modifier keys are at least 56dp x 44dp; every touch target is at least 48dp. -->
