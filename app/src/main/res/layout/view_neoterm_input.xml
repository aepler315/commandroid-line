<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/black"
    android:theme="@style/Theme.Termux.Black"
    android:orientation="vertical">

    <TextView
        android:id="@+id/neoterm_runtime_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp"
        android:text="@string/neoterm_runtime_notice" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">
            <RadioGroup
                android:id="@+id/neoterm_modes"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:checkedButton="@+id/neoterm_mode_auto"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/neoterm_mode_auto"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:saveEnabled="false"
                    android:text="@string/neoterm_auto" />
                <RadioButton
                    android:id="@+id/neoterm_mode_text"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:saveEnabled="false"
                    android:text="@string/neoterm_text" />
                <RadioButton
                    android:id="@+id/neoterm_mode_terminal"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:saveEnabled="false"
                    android:text="@string/neoterm_terminal" />
            </RadioGroup>
            <Button
                android:id="@+id/neoterm_compose"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="0dp"
                android:text="@string/neoterm_compose" />
            <Button
                android:id="@+id/neoterm_keys"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="0dp"
                android:text="@string/neoterm_keys" />
            <CheckBox
                android:id="@+id/neoterm_cmd"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:contentDescription="@string/commandroid_cmd_description"
                android:saveEnabled="false"
                android:text="@string/commandroid_cmd" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/neoterm_draft_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="4dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/neoterm_draft_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:labelFor="@+id/neoterm_draft"
            android:text="@string/neoterm_draft_label" />
        <com.neoterm.input.CompositionEditText
            android:id="@+id/neoterm_draft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/neoterm_draft_hint"
            android:minLines="2"
            android:maxLines="5"
            android:saveEnabled="false" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/neoterm_transmit"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/neoterm_transmit" />
            <Button
                android:id="@+id/neoterm_clear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/neoterm_clear" />
            <Button
                android:id="@+id/neoterm_enter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="@string/neoterm_enter_description"
                android:text="@string/neoterm_enter" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
