<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/commandroid_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E1E"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/commandroid_session_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/commandroid_session_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#D4D4D4"
            android:textSize="14sp" />

        <Button
            android:id="@+id/commandroid_next_session"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/commandroid_next_session_description"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="@string/commandroid_next_session"
            android:textColor="#4EC9B0" />

        <Button
            android:id="@+id/commandroid_new_session"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/commandroid_new_session_description"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="@string/commandroid_new_session"
            android:textColor="#4EC9B0" />
    </LinearLayout>

    <com.aepler.commandroid.ui.neoterm.NeoTermView
        android:id="@+id/commandroid_terminal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/commandroid_terminal_description"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Filled at runtime with the modifier key strip (CTRL, ALT, TAB, ESC, arrows). -->
    <LinearLayout
        android:id="@+id/commandroid_modifier_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />
</LinearLayout>
